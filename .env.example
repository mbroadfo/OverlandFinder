# ===================================================================
# Local Development Environment Variables
# Copy this to .env and fill in your actual values
# ===================================================================

# MongoDB Atlas Connection (for batch state management)
MONGODB_URI=mongodb+srv://mbroadfo_db_user:<password>@overland-finder-cluster.tfehxpn.mongodb.net/?appName=overland-finder-cluster

# Azure Foundry / OpenAI (for AI deal evaluation)
FOUNDRY_ENDPOINT=https://your-project.openai.azure.com/
FOUNDRY_MODEL=gpt-4o
FOUNDRY_API_KEY=your-api-key-here

# SMS Configuration (Verizon email-to-SMS gateway)
SMS_RECIPIENT=YOUR_NUMBER@vtext.com  # Replace with your 10-digit Verizon number

# SMTP for sending SMS (uses Gmail to relay to Verizon gateway)
# Gmail App Password (NOT your login password):
#   1. Go to https://myaccount.google.com/apppasswords
#   2. Create new app password → copy the 16-char code
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-gmail@gmail.com
SMTP_PASSWORD=your-16-char-app-password

# Local Development Flags
DEBUG=true
RUN_LOCAL=true

# ===================================================================
# Vehicle Search Criteria (used by scrapers)
# ===================================================================
MAX_PURCHASE_PRICE=10000
UPGRADE_BUDGET=5000
TOTAL_BUDGET=15000

# Vehicle Search Criteria
TARGET_VEHICLES=Jeep Wrangler,Toyota 4Runner,Toyota Tacoma,Toyota Land Cruiser,Lexus GX470,Lexus GX460,Lexus LX470,Nissan Xterra,Nissan Frontier,Ford Bronco,Chevy Colorado,Chevy ZR2

# Year Range (focused on reliable platforms)
MIN_YEAR=2000
MAX_YEAR=2020

# Mileage (higher OK if well-maintained)
MAX_MILEAGE=200000

# Location
SEARCH_LOCATION=Denver,Colorado
SEARCH_RADIUS_MILES=100

# Value Hunting Strategy
MIN_VALUE_DISCOUNT_PERCENT=20
IDEAL_VALUE_DISCOUNT_PERCENT=30

# Deal Types to Consider
ACCEPT_COSMETIC_DAMAGE=true
ACCEPT_HIGH_MILEAGE=true
ACCEPT_OLDER_VEHICLES=true
ACCEPT_SALVAGE_TITLE=true

# Colorado Title Requirements
REJECT_EXPORT_ONLY=true
REJECT_NON_REPAIRABLE=true

# Monitoring Settings
CHECK_INTERVAL_HOURS=4
ENABLE_NOTIFICATIONS=true
NOTIFICATION_EMAIL=your-email@example.com

# Data Storage
DATABASE_FILE=overlanding_deals.json
SEEN_LISTINGS_FILE=seen_listings.txt
