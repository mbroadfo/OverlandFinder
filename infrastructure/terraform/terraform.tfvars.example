# Example Terraform Variables
# Copy this file to terraform.tfvars and fill in your values

project_name = "overland-finder"
environment  = "dev"
location     = "eastus"

# MongoDB Atlas connection string (get from Atlas dashboard)
mongodb_uri = "mongodb+srv://username:password@cluster.mongodb.net/overland_finder?retryWrites=true&w=majority"

# SMTP configuration for sending SMS via email gateway
smtp_username = "your-email@gmail.com"
smtp_password = "your-app-specific-password"

# Azure Foundry/OpenAI endpoint
foundry_endpoint = "https://your-project.openai.azure.com/"
foundry_model_deployment = "gpt-4o"

# SMS recipient (Verizon email-to-SMS gateway)
sms_recipient = "7208399656@vtext.com"

# Scraper schedule (every 4 hours)
scraper_schedule = "0 */4 * * *"

# Daily SMS schedule (8 AM MST)
sms_schedule = "0 8 * * *"

# Resource sizing
scraper_cpu    = 0.5
scraper_memory = "1Gi"

# Tags
tags = {
  Project     = "OverlandFinder"
  ManagedBy   = "Terraform"
  Repository  = "github.com/mbroadfo/OverlandFinder"
  Owner       = "Mike Broadfoot"
}
